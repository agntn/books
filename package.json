{
  "name": "@agntn/books",
  "version": "0.1.0",
  "description": "Unified book catalog and public-domain full-text provider library for AI agents",
  "keywords": [
    "omp-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/agntn/books#readme",
  "bugs": "https://github.com/agntn/books/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/books.git"
  },
  "bin": {
    "books": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/shared",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/tools": "0.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "node-html-parser": "9.0.1",
    "ofetch": "1.5.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "26.2.0",
    "ai": "7.0.122",
    "changelogen": "0.6.2",
    "obuild": "0.4.38",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typebox": "1.3.18",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@earendil-works/pi-tui": ">=0.84.2 <1",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/books.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/books.ts"
    ]
  }
}
