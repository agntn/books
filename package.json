{
  "name": "@agntn/books",
  "version": "0.1.0",
  "description": "Unified book catalog and public-domain full-text provider library for AI agents",
  "keywords": [
    "omp-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/agntn/books#readme",
  "bugs": "https://github.com/agntn/books/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/books.git"
  },
  "bin": {
    "books": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/shared",
    "extensions/omp",
    "extensions/pi"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "node-html-parser": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "obuild": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@earendil-works/pi-tui": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.17.0",
  "omp": {
    "extensions": [
      "./extensions/omp/books.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/books.ts"
    ]
  }
}
